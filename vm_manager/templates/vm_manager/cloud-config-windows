#cloud-config

timezone: {{ timezone }}

users:
- name: {{ username }}
  passwd: {{ password }}
  gecos: VDI User
  groups:
  - Administrators
- name: nectar
  gecos: Nectar Admin
  groups:
  - Administrators
  ssh_authorized_keys:
  - cert-authority ssh-rsa  Nectar-service-instance-CA

write_files:
- path: C:\ProgramData\Nectar\scripts\90-phone_home.ps1
  content: |
    . "$env:ProgramData\Nectar\lib.ps1"
    Log "Starting Virtual Desktop phone home..."
    for ($i = 1; $i -le 5; $i++) {
        try {
            $metadata = Invoke-WebRequest -Uri http://169.254.169.254/openstack/latest/meta_data.json -UseBasicParsing | ConvertFrom-Json
            $result = Invoke-WebRequest -Uri {{ phone_home_url }} -Method POST -Body @{instance_id=$metadata.uuid} -UseBasicParsing
            Log "Phone home result: $($result.StatusCode) $($result.Content)"
            break
        }
        catch {
            Log "Phone home failure (attempt $i): $($_.Exception.Message) $($_.ErrorDetails.Message)"
            Start-Sleep -Seconds 10
        }
    }

runcmd:
  - powershell.exe -Command "New-ItemProperty -Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System' -Name LocalAccountTokenFilterPolicy -Value 1 -PropertyType DWord -Force"
